{
  "private": true,
  "name": "shellx-motion",
  "version": "0.2.68",
  "description": "Local-first motion graphics and video rendering engine built to be driven by AI agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/martinsbrezauckis/shellx-motion.git"
  },
  "homepage": "https://github.com/martinsbrezauckis/shellx-motion#readme",
  "bugs": {
    "url": "https://github.com/martinsbrezauckis/shellx-motion/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.6.0"
  },
  "//packageManager": [
    "The reproducible package-manager identity. `engines.pnpm` states what is COMPATIBLE; this",
    "states what the lockfile, the clean-install allowance and every green gate were actually",
    "produced with, so a fresh clone resolves the same tree instead of a merely-permitted one.",
    "10.33.0 and not 11.x: pnpm-lock.yaml is lockfileVersion 9.0 written by 10.33.0, and it is the",
    "`onlyBuiltDependencies` spelling in pnpm-workspace.yaml (the pnpm 10 key) that a pnpm 10",
    "clean install reads. Both spellings stay in that file, so a caller who bypasses this field on",
    "pnpm 11 still installs; the field is what makes the verified path the default one.",
    "CI does not repeat the number: pnpm/action-setup reads this field.",
    "No corepack `+sha512...` suffix \u2014 pnpm/action-setup passes the value to `pnpm install`",
    "verbatim, and a build-metadata suffix is not a resolvable registry version."
  ],
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "tsx packages/debug-server/src/user-launcher.ts",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "node scripts/public/build.mjs",
    "build:clean": "node scripts/public/build.mjs --clean",
    "build:verify": "node scripts/public/verify-install.mjs",
    "test": "pnpm run test:public",
    "test:public": "tsx scripts/public/run-public-test-children.ts",
    "test:scripts": "vitest run --config vitest.scripts.config.ts --pool=forks --maxWorkers=1 --no-file-parallelism",
    "source-hygiene:check": "pnpm run source-hygiene:public && node scripts/public/tracked-import-gate.mjs",
    "source-hygiene:public": "node scripts/public/no-nul-bytes.mjs && node scripts/public/job-status-lint.mjs && node scripts/public/shipping-imports-gate.mjs && node scripts/public/canonical-determinism-gate.mjs && node scripts/public/test-timeout-floor-gate.mjs",
    "sbom:generate": "node scripts/public/generate-sbom.mjs",
    "sbom:check": "node scripts/public/sbom-gate.mjs",
    "version:sync": "tsx scripts/public/version-parity.ts",
    "version:check": "tsx scripts/public/version-parity.ts --check",
    "pack:check": "node scripts/public/packed-files-gate.mjs && node scripts/public/shipping-reachability-gate.mjs",
    "architecture:check": "node scripts/public/module-size-gate.mjs",
    "corpus:check": "tsx scripts/public/package-corpus-validate-gate.ts",
    "docs:debug-api": "node scripts/public/generate-debug-api-reference.mjs",
    "docs:job-status": "node scripts/public/generate-job-status.mjs",
    "docs:commands": "node scripts/public/readme-commands-smoke.mjs",
    "docs:platform-verification": "node scripts/public/platform-verification-doc-gate.mjs",
    "docs:validation": "tsx scripts/public/generate-motion-validation-doc.ts",
    "docs:color-pipeline": "tsx scripts/public/generate-color-pipeline-doc.ts",
    "docs:rendering-samples": "tsx scripts/public/rendering-sample-catalog.ts --write",
    "docs:rendering-samples:check": "tsx scripts/public/rendering-sample-catalog.ts --check",
    "docs:rendering-samples:release-gate": "tsx scripts/public/rendering-sample-catalog.ts --release-gate",
    "rendering-samples:proof": "tsx scripts/public/rendering-samples-proof.ts",
    "docs:check": "node scripts/public/generate-debug-api-reference.mjs --check && node scripts/public/generate-job-status.mjs --check && node scripts/public/platform-verification-doc-gate.mjs --check && tsx scripts/public/generate-motion-validation-doc.ts --check && tsx scripts/public/generate-color-pipeline-doc.ts --check && tsx scripts/public/rendering-sample-catalog.ts --check && node scripts/public/markdown-link-integrity.mjs && node scripts/public/docs-retired-claims-gate.mjs && node scripts/public/semantic-documentation-contract.mjs && tsx scripts/public/gradient-authoring-contract.ts && node scripts/public/agent-script-cookbook-contract.mjs && node scripts/public/readme-commands-smoke.mjs && node scripts/public/notice-attribution-gate.mjs && node scripts/public/binary-asset-provenance.mjs --check",
    "args:check": "tsx scripts/public/debug-arg-coverage.ts",
    "debug:coverage": "pnpm --filter @shellx-motion/actions run coverage",
    "trust:coverage": "vitest run --config vitest.trust-coverage.config.ts",
    "color-alpha:check": "vitest run --config vitest.color-alpha.config.ts",
    "particle-field:check": "vitest run --config vitest.particle-field.config.ts",
    "agent:smoke": "tsx scripts/public/prompt-execution-smoke.ts",
    "agent-unavailable:smoke": "tsx scripts/public/prompt-unavailable-smoke.ts",
    "debug-server:smoke": "tsx scripts/public/debug-server-smoke.ts",
    "debug-server-prompt:smoke": "tsx scripts/public/debug-server-prompt-smoke.ts",
    "validate:fixtures": "pnpm --filter @shellx-motion/cli run cli -- validate fixtures/packages/lower-third",
    "package-archive:smoke": "tsx scripts/public/package-archive-smoke.ts",
    "canvas-package-preview:smoke": "tsx scripts/public/canvas-package-preview-smoke.ts",
    "evidence-surfaces:smoke": "tsx scripts/public/evidence-surfaces-smoke.ts",
    "sandbox:probe": "tsx scripts/public/sandbox-capability-probe.ts",
    "tracking:smoke": "tsx scripts/public/tracking-analysis-smoke.ts",
    "platform:verify": "node scripts/public/platform-verify.mjs",
    "render:smoke": "node scripts/public/prepare-repo-scratch.mjs && pnpm --filter @shellx-motion/cli run cli -- preview fixtures/packages/lower-third --out .scratch/previews",
    "render-mp4:smoke": "tsx scripts/public/render-mp4-smoke.ts",
    "render-rich-depth-promo:smoke": "tsx scripts/public/render-rich-depth-promo-smoke.ts",
    "render-restricted-shader:smoke": "tsx scripts/public/render-restricted-shader-smoke.ts",
    "render-fixed-scene3d:smoke": "tsx scripts/public/render-fixed-scene3d-smoke.ts",
    "render-rich-combined:smoke": "tsx scripts/public/render-rich-combined-smoke.ts",
    "ffmpeg-acceleration:smoke": "tsx scripts/public/ffmpeg-acceleration-smoke.ts",
    "render-hevc:smoke": "tsx scripts/public/render-modern-codec-smoke.ts mp4-hevc",
    "render-av1:smoke": "tsx scripts/public/render-modern-codec-smoke.ts webm-av1",
    "render-webm:smoke": "tsx scripts/public/render-webm-smoke.ts",
    "render-audio:smoke": "tsx scripts/public/render-audio-smoke.ts",
    "render-caption:smoke": "tsx scripts/public/render-caption-smoke.ts",
    "keying-roto-workflow:smoke": "tsx scripts/public/keying-roto-workflow-smoke.ts",
    "cutout-rig-bake-workflow:smoke": "tsx scripts/public/cutout-rig-bake-workflow-smoke.ts",
    "render-alpha:smoke": "tsx scripts/public/render-alpha-smoke.ts",
    "render-gif:smoke": "tsx scripts/public/render-gif-smoke.ts",
    "render-jpeg:smoke": "tsx scripts/public/render-jpeg-smoke.ts",
    "browser:capture-smoke": "tsx scripts/public/browser-workflow-smoke.ts",
    "workbench:ui-smoke": "tsx scripts/public/workbench-ui-clickthrough.ts",
    "renderer:benchmark": "tsx scripts/public/renderer-session-benchmark.ts",
    "renderer:benchmark:matrix": "tsx scripts/public/renderer-workload-matrix.ts",
    "renderer:benchmark:extended": "tsx scripts/public/renderer-workload-matrix.ts --extended",
    "source-storyboard:smoke": "tsx scripts/public/source-storyboard-cut-smoke.ts",
    "render-job-lifecycle:smoke": "tsx scripts/public/render-job-lifecycle-smoke.ts",
    "render-batch:smoke": "tsx scripts/public/render-batch-smoke.ts",
    "connector:smoke": "tsx scripts/public/connector-canvas-fixture-cut-smoke.ts",
    "connector:canvas-bridge-smoke": "tsx scripts/public/connector-canvas-bridge-smoke.ts",
    "connector:canvas-bridge-mp4-smoke": "tsx scripts/public/connector-canvas-bridge-mp4-smoke.ts",
    "connector:canvas-mp4-smoke": "tsx scripts/public/connector-canvas-mp4-smoke.ts",
    "connector:script-cut-smoke": "tsx scripts/public/connector-script-cut-smoke.ts",
    "connector:template-cut-render-smoke": "tsx scripts/public/connector-template-cut-render-smoke.ts",
    "connector:canvas-cut-smoke": "tsx scripts/public/connector-canvas-cut-smoke.ts",
    "real-workflow:canvas-feature": "tsx scripts/public/real-workflow-canvas-feature-announcement.ts",
    "real-workflow:advanced-effects": "tsx scripts/public/real-workflow-advanced-effects.ts",
    "template-pack:proof": "tsx scripts/public/template-product-pack-proof.ts",
    "contracts:generate": "tsx scripts/public/generate-public-contracts.ts",
    "contracts:check": "tsx scripts/public/generate-public-contracts.ts --check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "playwright-core": "^1.57.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "3.3.18"
    }
  }
}
