          "startMs": 0,
          "durationMs": 1900,
          "layerIds": ["hero-scene", "fog-stage"],
          "mediaParamIds": ["heroMedia"],
          "cameraIntent": "A slow push through layered atmosphere."
        },
        {
          "id": "name",
          "label": "Name",
          "intent": "Land the cinematic title while light volumes travel behind it.",
          "startMs": 850,
          "durationMs": 3400,
          "layerIds": ["eyebrow", "title", "subtitle", "fog-stage"],
          "mediaParamIds": ["heroMedia"],
          "cameraIntent": "Hold typography centrally while atmospheric depth remains active."
        },
        {
          "id": "clear",
          "label": "Clear",
          "intent": "Reduce density into a memorable resolved frame.",
          "startMs": 4200,
          "durationMs": 1800,
          "layerIds": ["accent-line", "title", "fog-stage", "finish"],
          "cameraIntent": "Let fog recede around the centered title."
