    { "paramId": "fogDensity", "target": { "kind": "motion_path", "path": "/layers/1/environment/fog/density", "layerId": "fog-stage" } },
    { "paramId": "accentColor", "target": { "kind": "motion_path", "path": "/layers/1/environment/lightColor", "layerId": "fog-stage" } },
    { "paramId": "accentColor", "target": { "kind": "motion_path", "path": "/layers/6/fill", "layerId": "accent-line" } }
