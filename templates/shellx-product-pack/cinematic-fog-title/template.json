    { "paramId": "title", "target": { "kind": "motion_path", "path": "/layers/4/text", "layerId": "title" } },
    { "paramId": "subtitle", "target": { "kind": "motion_path", "path": "/layers/5/text", "layerId": "subtitle" } },
