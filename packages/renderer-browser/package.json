{
  "name": "@shellx-motion/renderer-browser",
  "version": "0.2.66",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./internal/effect-modules": "./src/effect-module-registry.ts",
    "./internal/private-output-publication": "./src/private-output-publication.ts",
    "./internal/checkpoint-storyboard-terminal-boundary": "./src/checkpoint-storyboard-terminal-boundary.ts",
    "./internal/checkpoint-storyboard-retained-trace-preview": "./src/gpu-checkpoint-storyboard-retained-trace-preview.ts",
    "./internal/scene3d-gltf-pbr-final": "./src/gpu-scene3d-gltf-pbr-final.ts",
    "./internal/scene3d-gltf-pbr-hdr10": "./src/gpu-scene3d-gltf-pbr-hdr10-session.ts",
    "./internal/scene3d-gltf-pbr-hdr10-streaming": "./src/gpu-scene3d-gltf-pbr-hdr10-streaming-producer.ts",
    "./internal/linear-srgb-sdr-final": "./src/linear-srgb-sdr-final-webgpu-producer.ts",
    "./internal/gltf-object-retained-render": "./src/gpu-gltf-object-retained-session.ts"
  },
  "files": [
    "dist",
    "bin/enforced-untrusted-browser-launcher.mjs"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./internal/effect-modules": {
        "types": "./dist/effect-module-registry.d.ts",
        "default": "./dist/effect-module-registry.js"
      },
      "./internal/private-output-publication": {
        "types": "./dist/private-output-publication.d.ts",
        "default": "./dist/private-output-publication.js"
      },
      "./internal/checkpoint-storyboard-terminal-boundary": {
        "types": "./dist/checkpoint-storyboard-terminal-boundary.d.ts",
        "default": "./dist/checkpoint-storyboard-terminal-boundary.js"
      },
      "./internal/checkpoint-storyboard-retained-trace-preview": {
        "types": "./dist/gpu-checkpoint-storyboard-retained-trace-preview.d.ts",
        "default": "./dist/gpu-checkpoint-storyboard-retained-trace-preview.js"
      },
      "./internal/gltf-object-retained-render": {
        "types": "./dist/gpu-gltf-object-retained-session.d.ts",
        "default": "./dist/gpu-gltf-object-retained-session.js"
      },
      "./internal/scene3d-gltf-pbr-final": {
        "types": "./dist/gpu-scene3d-gltf-pbr-final.d.ts",
        "default": "./dist/gpu-scene3d-gltf-pbr-final.js"
      },
      "./internal/scene3d-gltf-pbr-hdr10-streaming": {
        "types": "./dist/gpu-scene3d-gltf-pbr-hdr10-streaming-producer.d.ts",
        "default": "./dist/gpu-scene3d-gltf-pbr-hdr10-streaming-producer.js"
      },
      "./internal/linear-srgb-sdr-final": {
        "types": "./dist/linear-srgb-sdr-final-webgpu-producer.d.ts",
        "default": "./dist/linear-srgb-sdr-final-webgpu-producer.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs --package @shellx-motion/renderer-browser",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --testTimeout=45000"
  },
  "dependencies": {
    "@shellx-motion/compositing-keying": "workspace:*",
    "@shellx-motion/core": "workspace:*",
    "playwright-core": "^1.62.1"
  }
}
