{
  "name": "@shellx-motion/renderer-native",
  "version": "0.2.65",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./internal/private-output-publication": "./src/private-output-publication.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./internal/private-output-publication": {
        "types": "./dist/private-output-publication.d.ts",
        "default": "./dist/private-output-publication.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs --package @shellx-motion/renderer-native",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --testTimeout=45000"
  },
  "dependencies": {
    "@shellx-motion/core": "workspace:*"
  }
}
