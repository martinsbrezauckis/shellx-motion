{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shellx-motion/platform-verification@1",
  "type": "object",
  "required": ["schema", "status", "dryRun", "host", "toolchain", "repoRoot", "startedAt", "finishedAt", "commandSummary", "commands"],
  "properties": {
    "schema": { "const": "shellx-motion/platform-verification@1" },
    "status": { "enum": ["planned", "running", "passed", "failed"] },
    "dryRun": { "type": "boolean" },
    "host": {
      "type": "object",
      "required": ["id", "hostname", "platform", "arch", "release", "node"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 }
      }
    },
    "toolchain": {
      "type": "object",
      "required": ["status", "exact", "bundledCodecs"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "exact": { "type": "boolean" },
        "bundledCodecs": { "type": "boolean" },
        "workspace": { "type": "object" },
        "node": { "type": "object" },
        "pnpm": { "type": "object" },
        "ffmpeg": { "type": "object" },
        "ffprobe": { "type": "object" },
        "encoders": { "type": "object" }
      }
    },
    "hostMatrix": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "current": { "type": "string", "minLength": 1 },
        "currentRequired": { "type": "boolean" },
        "satisfied": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } },
        "complete": { "type": "boolean" },
        "status": { "enum": ["complete", "partial"] }
      }
    },
    "repoRoot": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "minLength": 1 },
    "finishedAt": { "type": "string", "minLength": 1 },
    "commandSummary": {
      "type": "object",
      "required": ["total", "passed", "failed", "skipped", "skippedByKind"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "skippedByKind": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "command", "required", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "required": { "type": "boolean" },
          "category": { "type": "string" },
          "requiresEnv": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["planned", "pending", "running", "passed", "failed", "skipped"] },
          "durationMs": { "type": "number", "minimum": 0 },
          "exitCode": { "type": "integer" },
          "signal": { "type": ["string", "null"] },
          "skipReason": { "type": "string" },
          "stdoutTail": { "type": "string" },
          "stderrTail": { "type": "string" }
        }
      }
    }
  }
}
