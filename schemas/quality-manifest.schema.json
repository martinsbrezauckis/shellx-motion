{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shellx-motion/quality-manifest@1",
  "type": "object",
  "required": ["schema", "samples"],
  "properties": {
    "schema": { "const": "shellx-motion/quality-manifest@1" },
    "audio": {
      "type": "object",
      "properties": {
        "expect": { "type": "boolean" },
        "maxPeakDb": { "type": "number" },
        "minPeakDb": { "type": "number" },
        "minMeanDb": { "type": "number" },
        "minIntegratedLoudnessLufs": { "type": "number" },
        "maxIntegratedLoudnessLufs": { "type": "number" },
        "maxTruePeakDbtp": { "type": "number" },
        "maxLoudnessRangeLu": { "type": "number", "minimum": 0 }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "atMs": { "type": "number", "minimum": 0 },
          "baseline": { "type": "string", "minLength": 1 },
          "minBrightPixels": { "type": "number", "minimum": 0 },
          "minEdgePixels": { "type": "number", "minimum": 0 },
          "minLumaRange": { "type": "number", "minimum": 0 },
          "minTransparentPixels": { "type": "number", "minimum": 0 },
          "minNonTransparentPixels": { "type": "number", "minimum": 0 },
          "maxChangedPixels": { "type": "number", "minimum": 0 },
          "maxMeanDiff": { "type": "number", "minimum": 0 },
          "minPsnrDb": { "type": "number", "minimum": 0 },
          "minSsim": { "type": "number", "minimum": 0, "maximum": 1 },
          "compareAlpha": { "type": "boolean" },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["x", "y", "width", "height"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "x": { "type": "integer", "minimum": 0 },
                "y": { "type": "integer", "minimum": 0 },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 },
                "minDarkPixels": { "type": "number", "minimum": 0 },
                "minBrightPixels": { "type": "number", "minimum": 0 },
                "minEdgePixels": { "type": "number", "minimum": 0 },
                "minTransparentPixels": { "type": "number", "minimum": 0 },
                "minNonTransparentPixels": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
