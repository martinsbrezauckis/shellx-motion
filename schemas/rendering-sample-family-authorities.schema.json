{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shellx-motion/rendering-sample-family-authorities@1",
  "title": "ShellX Motion public rendering-family authorities",
  "description": "The closed public rendering-family authority inventory and primary MotionLayerType discovery mapping. It is not an inventory of every authoring mutation or tool. Every family entry must point at an existing public documentation anchor and a generated Action or Debug contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "primaryLayerTypeFamilies", "families"],
  "properties": {
    "schema": { "const": "shellx-motion/rendering-sample-family-authorities@1" },
    "primaryLayerTypeFamilies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layerType", "familyId"],
        "properties": {
          "layerType": { "type": "string", "minLength": 1, "maxLength": 80 },
          "familyId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}@[1-9][0-9]*$" }
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "documentation", "machineAuthority"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}@[1-9][0-9]*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "documentation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "anchor"],
            "properties": {
              "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[a-zA-Z0-9._/-]+$" },
              "anchor": { "type": "string", "pattern": "^[a-z0-9-]{1,100}$" }
            }
          },
          "machineAuthority": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind", "id"],
            "properties": {
              "path": { "enum": ["schemas/actions.json", "schemas/debug.json"] },
              "kind": { "enum": ["action", "debug-command"] },
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,120}$" }
            }
          }
        }
      }
    }
  }
}
