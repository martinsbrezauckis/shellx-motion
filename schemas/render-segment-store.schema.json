{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shellx-motion/render-segment-store@1",
  "$comment": "Internal durable segment checkpoint storage. It is a schema artifact, not a user-callable render mode.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "planFingerprint", "plan", "package", "frameLane", "producer", "timeline", "intermediate", "completed"],
  "properties": {
    "schema": { "const": "shellx-motion/render-segment-store@1" },
    "planFingerprint": { "$ref": "#/$defs/sha256" },
    "plan": { "$ref": "#/$defs/plan" },
    "package": { "$ref": "#/$defs/package" },
    "frameLane": { "enum": ["browser", "native"] },
    "producer": { "$ref": "#/$defs/producerFacts" },
    "timeline": { "$ref": "#/$defs/timeline" },
    "intermediate": { "$ref": "#/$defs/intermediate" },
    "delivery": { "$ref": "#/$defs/delivery" },
    "completed": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/checkpoint" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "startFrame", "endFrameExclusive", "frameCount"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 511 },
        "startFrame": { "type": "integer", "minimum": 0, "maximum": 35999 },
        "endFrameExclusive": { "type": "integer", "minimum": 1, "maximum": 36000 },
        "frameCount": { "type": "integer", "minimum": 1, "maximum": 36000 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "frameCount", "segmentFrames", "segmentCount", "ranges"],
      "properties": {
        "schema": { "const": "shellx-motion/render-segment-plan@1" },
        "frameCount": { "type": "integer", "minimum": 1, "maximum": 36000 },
        "segmentFrames": { "type": "integer", "minimum": 1, "maximum": 36000 },
        "segmentCount": { "type": "integer", "minimum": 1, "maximum": 512 },
        "ranges": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/range" } }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "manifestSha256", "contentSha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "contentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scriptSource": {
      "type": "object", "additionalProperties": false,
      "required": ["layerId", "layerType", "path", "sha256", "bytes"],
      "properties": {
        "layerId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "layerType": { "enum": ["web", "html", "canvas"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "scriptExecution": {
      "description": "Host-owned bounded script verdict.",
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema", "detectedClass", "requestedMode", "activeMode", "resolverVersion", "sources"],
          "properties": {
            "schema": { "const": "shellx-motion/script-execution@1" }, "detectedClass": { "const": "data-only" },
            "requestedMode": { "enum": ["none", "unrecognized", "trusted-local-agent-authored"] }, "activeMode": { "const": "data-only" },
            "resolverVersion": { "const": 1 }, "sources": { "type": "array", "maxItems": 0 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema", "detectedClass", "requestedMode", "activeMode", "resolverVersion", "packageSnapshotSha256", "attestationId", "sources", "entry"],
          "properties": {
            "schema": { "const": "shellx-motion/script-execution@1" }, "detectedClass": { "const": "active-content" },
            "requestedMode": { "const": "trusted-local-agent-authored" }, "activeMode": { "const": "trusted-local-agent-authored" },
            "resolverVersion": { "const": 1 }, "packageSnapshotSha256": { "$ref": "#/$defs/sha256" },
            "attestationId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "sources": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/scriptSource" } },
            "entry": { "$ref": "#/$defs/scriptSource" }
          }
        }
      ]
    },
    "producerFacts": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["frameLane"], "properties": { "frameLane": { "const": "native" } } },
        { "type": "object", "additionalProperties": false, "required": ["frameLane", "scriptExecution"], "properties": { "frameLane": { "const": "browser" }, "scriptExecution": { "$ref": "#/$defs/scriptExecution" } } }
      ]
    },
    "producerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "frameLane", "warningUnion", "warningsOmitted"],
      "properties": {
        "schema": { "const": "shellx-motion/segment-range-producer@1" },
        "frameLane": { "enum": ["browser", "native"] },
        "scriptExecution": { "$ref": "#/$defs/scriptExecution" },
        "warningUnion": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 400 } },
        "warningsOmitted": { "type": "integer", "minimum": 0 }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motionSha256", "durationMs", "fps", "width", "height"],
      "properties": {
        "motionSha256": { "$ref": "#/$defs/sha256" },
        "durationMs": { "type": "number", "exclusiveMinimum": 0 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "intermediate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container", "codec", "extension"],
      "properties": {
        "container": { "type": "string", "minLength": 1 },
        "codec": { "type": "string", "minLength": 1 },
        "extension": { "type": "string", "pattern": "^\\.[a-z0-9]{1,16}$" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "outputPathSha256", "preset", "audio", "quality", "forceSoftwareEncode", "verifyDeliveredColor"],
      "properties": {
        "schema": { "const": "shellx-motion/segmented-final-delivery@1" },
        "outputPathSha256": { "$ref": "#/$defs/sha256" },
        "preset": { "enum": ["mp4-h264", "webm-vp9-alpha"] },
        "audio": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contentSha256", "controlsSha256"],
            "properties": {
              "contentSha256": { "$ref": "#/$defs/sha256" },
              "controlsSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minDurationMs", "minUniqueFrameHashes"],
          "properties": {
            "minDurationMs": { "type": "number", "minimum": 0 },
            "minUniqueFrameHashes": { "type": "integer", "minimum": 0, "maximum": 36000 }
          }
        },
        "forceSoftwareEncode": { "type": "boolean" },
        "verifyDeliveredColor": { "type": "boolean" }
      }
    },
    "frameSequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sha256"],
      "properties": {
        "schema": { "const": "shellx-motion/render-segment-frame-sequence@1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byteLength"],
      "properties": {
        "path": { "type": "string", "pattern": "^segments/segment-[0-9]{6}\\.[a-z0-9]{1,16}$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1 }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "frameCount", "width", "height", "fps", "durationMs"],
      "properties": {
        "verified": { "const": true },
        "frameCount": { "type": "integer", "minimum": 1, "maximum": 36000 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "durationMs": { "type": "number", "minimum": 0 }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "range", "frameSequence", "frameHashes", "blankFrameCount", "producer", "artifact", "readback"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 511 },
        "range": { "$ref": "#/$defs/range" },
        "frameSequence": { "$ref": "#/$defs/frameSequence" },
        "frameHashes": { "type": "array", "maxItems": 36000, "items": { "$ref": "#/$defs/sha256" } },
        "blankFrameCount": { "type": "integer", "minimum": 0, "maximum": 36000 },
        "producer": { "$ref": "#/$defs/producerEvidence" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "readback": { "$ref": "#/$defs/readback" }
      }
    }
  }
}
